# tools/ 下只保留**自己写的配置与文档**；第三方二进制一律忽略。
# 用白名单（先全忽略再逐项放行）—— 靠扩展名枚举会漏掉解压出来的无扩展名
# Linux 二进制（实测 cloudflared-linux-amd64 38MB 差点被提交）。
# 需要二进制时按 `docs/cloudflare-tunnel-*.md` 里的命令重新下载。
tools/*
!tools/cloudflared/
tools/cloudflared/*
!tools/cloudflared/config-*.yml
__pycache__/
# 运行环境诊断等功能相关的运行时/实例文件
.mcp.json
.claude/
*.bun-build
gui/prototypes/
gui/src/prototypes/

# Codex 本地工具配置（保留但不跟踪）
.codex/
AGENTS.md

# 插件运行期数据目录（dev 下由插件进程写在 repo 根；
# 安装环境下宿主用的是 %APPDATA%/com.claudecode.gui/plugins-data/，不受此条影响）
plugins-data/

# memsearch 插件运行期状态（本机索引状态 + PID，不跨机共享）
.memsearch/

# 私有（含 API key 等敏感值，勿提交）
.private/

# mac 发布产物 —— release_mac.py make 从 gui.zip 内嵌 manifest 派生，
# 每次发布内容不同，不是源码
scripts/manifest.json

# 构建产物
/dist/

# 二进制资产（本地构建用，不入库）
/offline-tools/
/bin/*.exe

# 依赖
node_modules/
**/node_modules/

# Rust
**/target/

# 环境
.env
.env.*

# 插件签名产物 —— 描述的是某个具体 zip 的字节序列，不是源文件。
# 有私钥随时能重算（scripts/sign-plugin.py），入库只会每次都变、制造噪音。
# ⚠️ 但**发布时绝不能省**：无签名的包在市场上是 signed=false，
# 用户拿不到「安装」按钮（2026-11-07 事故）。签名由 pack-plugins.py 自动完成。
packages/plugins/*/*.sig
